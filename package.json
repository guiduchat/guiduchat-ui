{
  "name": "@guiduchat/ui",
  "version": "0.4.0",
  "author": "Guidu",
  "contributors": [
    "Vadim Tregubenko (autor original do @maxhub/max-ui)"
  ],
  "description": "Kit de UI do guidu.chat e dos mini-apps Guidu (baseado em @maxhub/max-ui 0.7.0, MIT)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.10.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "./dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guiduchat/guiduchat-ui.git"
  },
  "bugs": {
    "url": "https://github.com/guiduchat/guiduchat-ui/issues"
  },
  "homepage": "https://github.com/guiduchat/guiduchat-ui#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "rollup -c",
    "prepare": "husky",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@radix-ui/react-slot": "1.3.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.0",
    "@eslint-react/eslint-plugin": "5.19.0",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/icons": "2.2.0",
    "@storybook/react-vite": "10.5.10",
    "@stylistic/eslint-plugin": "5.10.0",
    "@svgr/rollup": "8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.14.0",
    "clsx": "2.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-n": "18.2.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "14.0.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "plop": "4.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rollup": "4.63.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "sass": "1.103.1",
    "storybook": "10.5.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.1.5",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.3"
  }
}
